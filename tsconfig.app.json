{
  // 禁用严格模式以避免类型实例化过深的问题
  "strict": false,
  // 跳过库类型检查
  "skipLibCheck": true,
  // 设置最大实例化深度
  "noErrorTruncation": false,
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*.ts", "src/**/*.vue", "src/**/*"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "moduleResolution": "node",

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "moduleResolution": "node"
}
